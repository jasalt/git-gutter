;;; git-gutter-staged.el --- Staged range mapping -*- lexical-binding: t; -*-
(require 'cl-lib)

(defun git-gutter:map-staged-hunks (staged unstaged)
  "Map ordered STAGED ranges through ordered UNSTAGED changes.
Build unchanged intervals once; intersect them with staged ranges."
  (let ((cursor 1) (offset 0) spans result)
    (dolist (info unstaged)
      (when (string-match
             "^@@ -\\([0-9]+\\)\\(?:,\\([0-9]+\\)\\)? +\\+[0-9]+\\(?:,\\([0-9]+\\)\\)? @@"
             (git-gutter-hunk-content info))
        (let* ((text (git-gutter-hunk-content info))
               (start (string-to-number (match-string 1 text)))
               (old (if (match-string 2 text) (string-to-number (match-string 2 text)) 1))
               (new (if (match-string 3 text) (string-to-number (match-string 3 text)) 1))
               (boundary (if (zerop old) (1+ start) start)))
          (when (< cursor boundary)
            (push (list cursor (1- boundary) offset) spans))
          (setq cursor (if (zerop old) boundary (+ start old))
                offset (+ offset (- new old))))))
    (push (list cursor most-positive-fixnum offset) spans)
    (setq spans (nreverse spans))
    ;; Remove occupied worktree lines (notably deletion-marker anchors).
    (let ((changes unstaged) clean)
      (dolist (span spans)
        (pcase-let* ((`(,low ,high ,shift) span)
                     (first (+ low shift)) (last (+ high shift)))
          (while (and changes (< (git-gutter-hunk-end-line (car changes)) first))
            (pop changes))
          (let ((remaining changes))
            (while (and remaining (<= (git-gutter-hunk-start-line (car remaining)) last))
              (let* ((change (pop remaining))
                     (a (git-gutter-hunk-start-line change))
                     (b (git-gutter-hunk-end-line change)))
                (when (< first a)
                  (push (list (- first shift) (- a shift 1) shift) clean))
                (setq first (max first (1+ b))))))
          (when (<= first last)
            (push (list (- first shift) (- last shift) shift) clean))))
      (setq spans (nreverse clean)))
    (dolist (info staged)
      (let ((start (git-gutter-hunk-start-line info))
            (end (git-gutter-hunk-end-line info)))
        (while (and spans (< (cadar spans) start)) (pop spans))
        (let ((remaining spans))
          (while (and remaining (<= (caar remaining) end))
            (pcase-let ((`(,low ,high ,shift) (pop remaining)))
              (push (make-git-gutter-hunk
                     :type (git-gutter-hunk-type info)
                     :start-line (+ (max start low) shift)
                     :end-line (+ (min end high) shift)) result))))))
    (nreverse result)))

(provide 'git-gutter-staged)
